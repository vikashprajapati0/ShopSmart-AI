# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/shopsmart_ai

# JWT Authentication
JWT_SECRET=shopsmart_super_secure_jwt_secret_dev_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Google Gemini AI API Key (Optional: will use smart catalog search fallback if not provided)
GEMINI_API_KEY=

# Razorpay Test Credentials (Optional: sandbox simulation mode available if left empty)
RAZORPAY_KEY_ID=rzp_test_shopsmart_dev
RAZORPAY_KEY_SECRET=shopsmart_secret_key_123456
RAZORPAY_WEBHOOK_SECRET=shopsmart_webhook_secret_key

# Cloudinary (Optional: image upload will use data URI/mock fallback if not provided)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email SMTP (Optional: Nodemailer will log to console in dev mode if not configured)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@shopsmart.ai
